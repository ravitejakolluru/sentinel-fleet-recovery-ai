# Frontend runtime
VITE_API_BASE_URL=https://sentinel-fleet-recovery-ai-api.onrender.com
VITE_WS_BASE_URL=wss://sentinel-fleet-recovery-ai-api.onrender.com
VITE_MAP_STYLE_URL=https://tiles.example.com/styles/robot-map/style.json
VITE_GOOGLE_MAPS_API_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend runtime
DATABASE_URL=mysql+pymysql://user:password@host:3306/sentinel
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=sentinel
MYSQL_USER=
MYSQL_PASSWORD=
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=3600000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
FRONTEND_URL=https://sentinel-robotics-frontend.example.com
CORS_ORIGINS=https://sentinel-robotics-frontend.example.com

# Optional Firebase Admin credentials for server-side verification
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional local overrides
SIMULATION_SEED=2026
AUTH_REDIRECT_URI=https://sentinel-robotics-frontend.example.com/auth/callback
